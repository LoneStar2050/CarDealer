# Copy to .env and adjust for your machine. Never commit .env.
PORT=3000
DATABASE_URL=postgres://localhost:5432/car_dealer
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Used by `npm run seed:admin` to create or promote the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
